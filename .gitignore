# Opportunity-specific generated output
/opportunities/*/*/pdfs/
/opportunities/*/*/typst/

# Private user knowledge; only the public scaffold and station example ship.
/interview/*
!/interview/README.md
!/interview/imports/
/interview/imports/*
!/interview/imports/README.md
!/interview/stations.toml

# Local build state
/.agent/cache/
__pycache__/
*.py[cod]
/target/

# Secrets
.env
.env.*
!.env.example

# Editor and office temporary files
.DS_Store
Thumbs.db
.nfs*
.~lock.*#
~$*.doc*
~$*.xls*
*.bak
*.log
*.tmp
