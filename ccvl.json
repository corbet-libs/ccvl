{
  "format": "ccvl-workspace",
  "schema_version": 5,
  "last_line_maximum": 102,
  "workspace_groups": {
    "interview": {
      "root": "interview",
      "stations": "interview/stations.toml"
    },
    "cvl": {
      "root": "cvl",
      "profile": "cvl/profile.toml",
      "de-CH": "cvl/de-ch/application.toml",
      "en-CH": "cvl/en-ch/application.toml"
    },
    "opportunities": {
      "root": "opportunities",
      "path": "opportunities/<organisation-key>/<position-key>",
      "record": "application.toml",
      "output": "output"
    }
  },
  "skills": [
    "ccvl-install",
    "ccvl-profile",
    "ccvl-cv",
    "ccvl-apply",
    "ccvl-interview",
    "ccvl-upskill",
    "ccvl-outcome"
  ],
  "styles": {
    "default": "harvard",
    "available": ["harvard", "harvard-compact"]
  },
  "documents": {
    "cv": {
      "de-CH": "cvl/de-ch/cv.typ",
      "en-CH": "cvl/en-ch/cv.typ",
      "presets": [2, 3, 4],
      "summary_lines": 5,
      "summary_fill": {"minimum": 95, "target": 97, "maximum": 100},
      "layout_contract": {
        "definition": "A station, project, or competency block is one full CV entry with its own heading and supporting content. Compact standalone lines do not count.",
        "page_1": { "entries": { "minimum": 6, "target": 7, "maximum": 8 } },
        "page_2": { "entries": 10, "bullets_per_entry": 2 },
        "page_3": { "entries": 10, "bullets_per_entry": 2 },
        "page_4": { "groups": 3, "entries_per_group": 3, "bullets_per_entry": 3 },
        "verified_only": true,
        "unique_fact_assignment": true
      }
    },
    "cover_letter": {
      "de-CH": "cvl/de-ch/cl.typ",
      "en-CH": "cvl/en-ch/cl.typ",
      "paragraphs": [
        {
          "number": 1,
          "role": "positioning",
          "purpose": "Name the target and establish immediate fit.",
          "lines": { "minimum": 3, "target": 3, "maximum": 3 }
        },
        {
          "number": 2,
          "role": "primary-evidence",
          "purpose": "Prove the strongest relevant experience and results.",
          "lines": { "minimum": 5, "target": 6, "maximum": 7 }
        },
        {
          "number": 3,
          "role": "complementary-evidence",
          "purpose": "Add complementary evidence and the career-wide pattern.",
          "lines": { "minimum": 5, "target": 6, "maximum": 7 }
        },
        {
          "number": 4,
          "role": "differentiation",
          "purpose": "Explain the value created by the combined evidence.",
          "lines": { "minimum": 5, "target": 6, "maximum": 7 }
        },
        {
          "number": 5,
          "role": "target-fit",
          "purpose": "Connect that value to the specific organisation and opportunity.",
          "lines": { "minimum": 5, "target": 6, "maximum": 7 }
        },
        {
          "number": 6,
          "role": "warm-close",
          "purpose": "Close warmly with a low-friction invitation to talk.",
          "lines": { "minimum": 2, "target": 3, "maximum": 3 }
        }
      ],
      "paragraph_regions": [
        {
          "paragraphs": [2, 3],
          "minimum": 10,
          "target": 12,
          "maximum": 12,
          "preferred_totals": [10, 12]
        },
        {
          "paragraphs": [4, 5],
          "minimum": 10,
          "target": 12,
          "maximum": 12,
          "preferred_totals": [10, 12]
        },
        {
          "paragraphs": [2, 3, 4, 5],
          "minimum": 20,
          "target": 22,
          "maximum": 22,
          "preferred_totals": [20, 21, 22]
        }
      ],
      "body_lines": { "minimum": 25, "target": 28, "maximum": 28 },
      "highlights": {
        "count": 5,
        "lines_each": 1,
        "position": "between-paragraphs-3-and-4",
        "purpose": "Provide a fast evidence index across the target's main selection dimensions."
      },
      "line_fill": {
        "body": { "minimum": 75, "target": 90, "maximum": 100 },
        "highlight": { "minimum": 60, "target": 82, "maximum": 100 }
      },
      "mirror_paragraphs": [1, 6],
      "keep_paragraphs_together": true,
      "justify_body": true,
      "vertical_rhythm": {
        "gap_pt": { "minimum": 12, "target": 20, "maximum": 30 },
        "highlight_center_percent": { "minimum": 50, "target": 56, "maximum": 60 }
      },
      "widow_or_orphan_lines": 0
    }
  }
}
