{
  "format": "ccvl-workspace",
  "schema_version": 8,
  "workspace_groups": {
    "interview": {
      "root": "interview",
      "stations": "interview/stations.toml"
    },
    "cvl": {
      "root": "cvl",
      "profile": "cvl/profile.toml",
      "cv": "cvl/cv",
      "cl": "cvl/cl"
    },
    "opportunities": {
      "root": "opportunities",
      "path": "opportunities/<organisation-key>/<position-key>",
      "record": "application.toml",
      "pdfs": "pdfs",
      "typst": "typst"
    }
  },
  "skills": [
    "ccvl-install",
    "ccvl-profile",
    "ccvl-cv",
    "ccvl-apply",
    "ccvl-interview",
    "ccvl-upskill",
    "ccvl-outcome",
    "ccvl-style"
  ],
  "documents": {
    "cv": {
      "root": "cvl/cv",
      "default_style": "harvard"
    },
    "cover_letter": {
      "root": "cvl/cl",
      "default_style": "harvard"
    }
  }
}
