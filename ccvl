#!/usr/bin/env bash
set -euo pipefail

repo_root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
binary="$repo_root/.agent/cache/ccvl/bin/ccvl"

command_name="${1:-help}"
shift || true

case "$command_name" in
  setup)
    exec bash "$repo_root/.agent/scripts/bootstrap.sh" install "$@"
    ;;
  bootstrap)
    exec bash "$repo_root/.agent/scripts/bootstrap.sh" plan "$@"
    ;;
  *)
    if [[ ! -x "$binary" ]]; then
      printf 'ccvl is not set up. Run bash ./ccvl bootstrap, then bash ./ccvl setup.\n' >&2
      exit 2
    fi
    probe() { command -v "$1" 2>/dev/null; }
    # shellcheck source=.agent/scripts/runtime-id.sh
    source "$repo_root/.agent/scripts/runtime-id.sh"
    expected="$(source_fingerprint)"
    if [[ -z "$expected" || "$("$binary" runtime-id 2>/dev/null)" != "$expected" ]]; then
      printf 'The installed ccvl runtime is stale. Run bash ./ccvl setup to install the matching binary.\n' >&2
      exit 2
    fi
    cd "$repo_root"
    exec "$binary" "$command_name" "$@"
    ;;
esac
